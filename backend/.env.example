# CIT Smart Scheduler - Backend Environment Variables
PROJECT_NAME="CIT Smart Scheduler Backend"
API_V1_STR="/api"
SECRET_KEY="cit_scheduler_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL supported; fallback to SQLite for local development without external service)
# Example for PostgreSQL: postgresql://cit_admin:cit_pass@localhost:5432/cit_scheduler
# Default fallback: sqlite:///./cit_scheduler.db
DATABASE_URL="sqlite:///./cit_scheduler.db"

# Allowed CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","*"]

# Academic Defaults
DEFAULT_ACADEMIC_TERM="Fall 2026 (Semester VII)"
DEFAULT_INSTITUTION="Chilika Institute of Technology"

# Gemini AI Assistant Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
